# Copie este arquivo para .env e preencha os valores.
# Nunca faça commit do arquivo .env.

# Ambiente: development | test | production
NODE_ENV=development
# Nível de log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# API HTTP
HOST=0.0.0.0
PORT=3000

# PostgreSQL. Local: `pnpm db:up` e `pnpm db:migrate` (credenciais apenas para desenvolvimento).
# Vazio: o cache do perfil fica desativado e os comandos `cache` e `refresh` não funcionam.
DATABASE_URL=postgresql://fraglens:fraglens@localhost:5432/fraglens

# Banco dedicado aos testes de integração (`pnpm test:db`). Ver docs/database.md.
TEST_DATABASE_URL=postgresql://fraglens:fraglens@localhost:5432/fraglens_test

# Steam Web API — crie sua chave em https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Leetify Public API — opcional. Sem chave a API funciona, com limites de requisição menores.
# Crie sua chave em https://leetify.com/app/developer
LEETIFY_API_KEY=

# Tempo de cache do perfil Steam, em segundos.
# Dados da Leetify nunca são guardados (ver docs/decisions/0001).
STEAM_PROFILE_CACHE_TTL=86400

# IA (opcional). Por enquanto apenas "none"; provedores serão adicionados na Fase 8.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
